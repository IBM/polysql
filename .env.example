# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: For custom inference engines
# RITS_API_KEY=your_rits_api_key_here
# RITS_API_BASE=https://your-rits-endpoint.com

# MySQL Configuration (for MySQL backend evaluation)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# PostgreSQL Configuration (for PostgreSQL backend evaluation)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# BigQuery Configuration (optional)
BIGQUERY_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Snowflake Configuration (optional)
SFDB_ACCOUNT=your_account
SFDB_USER=your_user
SFDB_PASSWORD=your_password
SFDB_WAREHOUSE=your_warehouse
SFDB_DATABASE=your_database
SFDB_SCHEMA=your_schema

# ClickHouse Configuration (optional)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password

# Databricks Configuration (optional)
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=your_databricks_token
